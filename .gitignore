# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Config with secrets (keep default but ignore user presets with keys)
configs/*.local.json
configs/llm_providers.json
configs/page_mcp_tokens.json

# Runtime mode/default configs contain real API keys & MCP tokens — never commit
configs/default.json
configs/mode_*.json
configs/ori.json
configs/quest.json
configs/test.json

# Generated audio previews / voice assets
configs/voice_previews/
configs/character_library/
configs/custom_voices/
configs/moss_previews/
configs/moss_voices/
configs/script_library/
configs/style_previews/

# Batch queue runtime state (console batch video generation)
configs/batch_queue.json

# Quick-config panel field selection per mode (console user preference)
configs/quick_config.json

# Channel factory runtime state (drafts / favorites / references / generated assets)
configs/channel_drafts.json
configs/channel_favorites.json
configs/channel_references.json
configs/channel_assets/

# Intro video library (sleep mode 10s intros, generated assets)
configs/intro_videos/
configs/intro_library.json

# Pipeline run outputs
output/

# Atlas split test outputs (manual verification only)
test/split_test_output/

# Copyright BGM music library (user-provided audio files)
bgm_music/

# OS
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/

# Codely CLI
.codely-cli/
